# Copying this template alone does not create credentials. Run deploy/setup.sh.
INSTALL_ROOT=/opt/bot-combined
PROJECT_SOURCE=/opt/bot-combined/source
COMPOSE_PROJECT_NAME=bot-combined
BRIDGE_NETWORK=bot-combined-network
BRIDGE_TOKEN=
QWENPAW_RUNTIME_INTERNAL_TOKEN=
ONEBOT_TOKEN=
QWENPAW_BASE_URL=http://qwenpaw:8088
QWENPAW_AGENT_ID=default
ASTRBOT_BRIDGE_URL=http://astrbot:9186
# Nonempty values override the AstrBot dashboard lists. Empty values use the
# dashboard configuration, whose empty defaults deny chat/tool access.
OWNER_USER_IDS=
TOOL_ALLOWLIST=
# Media stays inside a server-generated session directory under /bridge-files.
# Limits may be reduced; the bridge enforces a ceiling of 20 MiB / 4 attachments.
BRIDGE_MAX_FILE_BYTES=20971520
BRIDGE_MAX_FILES=4
BRIDGE_MEDIA_TIMEOUT=60
# AstrBot may copy inbound local media only from these dedicated cache roots.
BRIDGE_SOURCE_ROOTS=/AstrBot/data/temp
# Private HTTP downloads are restricted to these exact NapCat service names.
BRIDGE_NAPCAT_HOSTS=napcat
# This controls QwenPaw's additional login layer. Runtime boundary remains enabled.
# See docs/deployment.md before enabling auth; the bridge then needs a user API token.
QWENPAW_AUTH_ENABLED=false
ASTRBOT_MEMORY=640m
ASTRBOT_SWAP=1280m
QWENPAW_MEMORY=1536m
QWENPAW_SWAP=3072m
NAPCAT_MEMORY=768m
NAPCAT_SWAP=1536m
EXISTING_ASTRBOT_DIR=/opt/bot
EXISTING_ASTRBOT_CONTAINER=astrbot-weixin
EXISTING_ASTRBOT_PROJECT=astrbot-weixin
