{
  "enabled": {"description": "启用桥接", "type": "bool", "default": true},
  "owner_user_ids": {"description": "允许使用的用户ID", "type": "list", "default": [], "hint": "默认空：拒绝聊天。通过 /paw whoami 查询自己的ID。非空OWNER_USER_IDS环境变量优先，空值使用后台设置。"},
  "enabled_platforms": {"description": "允许的平台类型", "type": "list", "default": ["weixin_oc", "aiocqhttp"]},
  "tool_allowlist": {"description": "允许导出的AstrBot工具名", "type": "list", "default": [], "hint": "默认空禁用工具；明确填 * 可启用所有符合会话范围的插件/MCP工具。非空TOOL_ALLOWLIST环境变量优先，空值使用后台设置。"},
  "qwenpaw_url": {"description": "QwenPaw内网地址", "type": "string", "default": "http://qwenpaw:8088", "hint": "QWENPAW_BASE_URL环境变量优先。"},
  "agent_id": {"description": "QwenPaw Agent ID", "type": "string", "default": "default", "hint": "QWENPAW_AGENT_ID环境变量优先。"},
  "bridge_token": {"description": "私有桥接鉴权密钥", "type": "string", "default": "", "hint": "推荐使用BRIDGE_TOKEN环境变量。至少32字符随机密钥，禁止提交到Git。"},
  "runtime_token": {"description": "QwenPaw内部运行时密钥", "type": "string", "default": "", "hint": "推荐使用QWENPAW_RUNTIME_INTERNAL_TOKEN环境变量。"},
  "state_path": {"description": "独立桥接状态数据库", "type": "string", "default": "/AstrBot/data/plugin_data/qwenpaw_bridge/bridge.sqlite3"},
  "chat_timeout": {"description": "单次会话等待秒数", "type": "int", "default": 900},
  "tool_timeout": {"description": "工具总执行秒数", "type": "int", "default": 120},
  "files_root": {"description": "共享媒体根目录", "type": "string", "default": "/bridge-files", "hint": "AstrBot、QwenPaw和NapCat必须挂载同一绝对路径。BRIDGE_FILES_ROOT环境变量优先。"},
  "source_roots": {"description": "允许读取的入站本地附件目录", "type": "list", "default": [], "hint": "空列表默认使用AstrBot的temp目录，不允许读取整个data目录。BRIDGE_SOURCE_ROOTS逗号分隔环境变量优先。"},
  "max_file_bytes": {"description": "每附件最大字节数", "type": "int", "default": 20971520, "hint": "硬上限20MiB。BRIDGE_MAX_FILE_BYTES环境变量优先。"},
  "max_files": {"description": "每条消息最多附件数", "type": "int", "default": 4, "hint": "硬上限4。BRIDGE_MAX_FILES环境变量优先。"},
  "napcat_hosts": {"description": "允许内网HTTP下载的NapCat主机名", "type": "list", "default": ["napcat"], "hint": "仅固定主机允许私网；其它来源会验证公网HTTPS。BRIDGE_NAPCAT_HOSTS环境变量优先。"},
  "media_timeout": {"description": "单附件下载超时秒数", "type": "int", "default": 60, "hint": "BRIDGE_MEDIA_TIMEOUT环境变量优先。"}
}
